# Copy to .env. Never commit real credentials.
OPENROUTER_API_KEY=
EXA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# Service-account JSON encoded as base64, decoded only in memory.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global

# Generate a random token (at least 16 characters) for HTTP MCP.
MCP_AUTH_TOKEN=
WORKSPACE_ID=local
DATABASE_URL=file:./data/opensenpai.db
DATABASE_AUTH_TOKEN=
PORT=4111
HOST=127.0.0.1

# Optional split/container deployment settings.
VALKEY_URL=
INTERNAL_EXECUTION_TOKEN=
OBSERVATION_DISPATCH_MODE=native
# MASTRA_STORAGE_URL=file:./data/opensenpai.mastra.db
# MASTRA_STORAGE_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_ALLOWED_ORIGINS=
# TARGETS_JSON=[...]

# Paid acceptance tests are opt-in and use a cumulative spend artifact.
OPENSENPAI_LIVE_TESTS=0
E2E_TARGETS=router-exa
