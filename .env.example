# Copy to .env. Never commit real credentials.
OPENROUTER_API_KEY=
EXA_API_KEY=
# Native search uses OPENROUTER_API_KEY too; the adapter checks endpoint capabilities.
# An optional nativeSearch.apiKeyEnv in config/providers/openrouter.mjs can select another key.
# Provider modules can name additional credential variables; do not commit their values.
# OPENSENPAI_CONFIG=./opensenpai.config.mjs

# Generate a random token (at least 16 characters) for HTTP MCP and REST.
MCP_AUTH_TOKEN=
WORKSPACE_ID=local
# libsql for local/split Docker. Cloudflare sets its native backend automatically.
STORAGE_BACKEND=libsql
DATABASE_URL=file:./data/opensenpai.db
DATABASE_AUTH_TOKEN=
PORT=4111
HOST=127.0.0.1

# Optional split/container deployment settings.
VALKEY_URL=
INTERNAL_EXECUTION_TOKEN=
OBSERVATION_DISPATCH_MODE=native
# MASTRA_STORAGE_URL=file:./data/opensenpai.mastra.db
# MASTRA_STORAGE_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_ALLOWED_ORIGINS=
# TARGETS_JSON=[...]

# Cloudflare only: extra model/retrieval credential variable names.
# PROVIDER_API_KEY_ENVS=

# Paid acceptance tests are opt-in and use a cumulative spend artifact.
OPENSENPAI_LIVE_TESTS=0
# External agent defaults to Anthropic; use OpenRouter to share gateway credits.
# E2E_AGENT_PROVIDER=openrouter
# E2E_RESEARCH_MODELS=z-ai/glm-5.3-flash
# E2E_RESEARCH_PROVIDER=openrouter
# E2E_SEARCH_ENGINE=exa
# E2E_TARGETS=your-optional-preset
