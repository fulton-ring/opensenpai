{
  "name": "opensenpai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env apps/server/src/cli.ts",
    "start": "node --env-file-if-exists=.env apps/server/dist/cli.js",
    "studio": "mastra dev --dir apps/server/src/mastra --env .env",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test && vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:agent": "tsx --env-file-if-exists=.env scripts/e2e-real-agent.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^24.0.0",
    "mastra": "1.34.2",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.151.1",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.78.0",
    "@mastra/mcp": "2.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "libsql",
      "sharp",
      "workerd"
    ]
  }
}
