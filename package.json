{
  "name": "opensenpai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "opensenpai": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google-vertex": "5.0.115",
    "@ai-sdk/openai": "4.0.96",
    "@hono/node-server": "1.19.11",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.78.0",
    "@mastra/hono": "1.7.20",
    "@mastra/libsql": "1.26.2",
    "@mastra/mcp": "2.4.1",
    "@mastra/valkey-streams": "0.5.5",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.143",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.151.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "libsql",
      "sharp",
      "workerd"
    ]
  }
}
